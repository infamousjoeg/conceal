{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conceal",
  "version": "4.3.0-rc.1",
  "identifier": "com.joe-garcia.conceal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Conceal — Approval inbox",
        "width": 1180,
        "height": 820,
        "minWidth": 640,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/conceal-engine"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Review once. Approve exactly.",
    "longDescription": "A local approval inbox for exact Conceal service actions. Credentials stay in the operating system credential store until an approved request runs.",
    "macOS": { "minimumSystemVersion": "13.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
